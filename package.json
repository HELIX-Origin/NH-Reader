{
  "name": "nh-reader",
  "version": "0.6.1",
  "description": "A fast, privacy-focused cross-platform client for nhentai.net",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:app": "tauri build",
    "build:app:debug": "tauri build --debug",
    "sign:windows": "powershell -ExecutionPolicy Bypass -File scripts/sign.ps1",
    "mobile:android:init": "tauri android init",
    "mobile:android:build": "tauri android build --apk",
    "mobile:ios:init": "tauri ios init",
    "mobile:ios:build": "tauri ios build",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check:agents": "node scripts/check-agents.mjs"
  },
  "author": "HELIX Origin",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
